{
  "name": "agoryx",
  "version": "0.2.0",
  "description": "Local-first multi-agent chat orchestrator for Codex and Claude.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx cmd/agoryx/main.ts",
    "chat": "tsx cmd/agoryx/main.ts chat",
    "sessions": "tsx cmd/agoryx/main.ts sessions",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cli-cursor": "^5.0.0",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
